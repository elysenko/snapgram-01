generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth baseline (Colossus accounts-v1 contract) ────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  /// bcryptjs hash (BCRYPT_ROUNDS in prisma/seed/seed.js and the auth service). Never store plaintext.
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ─── SnapGram profile fields ───
  // All nullable on purpose: prisma/seed/seed.js creates platform accounts with
  // only {email, name, role, passwordHash}. A required column here would make the
  // essential seed exit 1 and leave the deployed app with no working login.
  /// Public profile slug used by /u/:handle. Derived from the email local part.
  handle      String? @unique
  /// Public display name. Falls back to `name`, then `handle`, in the API layer.
  displayName String?
  bio         String?
  /// Proxy path served by GET /api/media/:key, e.g. "/api/media/avatars/<id>.png".
  avatarUrl   String?

  posts     Post[]
  comments  Comment[]
  likes     Like[]
  reports   Report[]
  following Follow[]  @relation("UserFollowing")
  followers Follow[]  @relation("UserFollowers")

}

/// One value per role the stack contract declares (colossus.stack.json auth.roles:
/// ADMIN, MANAGER, USER). Colossus mints exactly one login per contract role and
/// prisma/seed/seed.js maps each onto this enum — a missing value makes the seed
/// exit 1 and the deployed app has no working login.
///
/// SnapGram actor mapping: spec `member` -> USER, spec `moderator` -> ADMIN.
/// MODERATOR exists so the frontend's UserRole union is satisfiable, but Colossus
/// mints NO login for it — gate the moderation queue on ADMIN (always minted).
enum Role {
  USER
  MANAGER
  MODERATOR
  ADMIN
}

/// Platform-owned logins, materialized by prisma/seed/seed.js from COLOSSUS_ACCOUNTS_JSON.
model ColossusAccount {
  id           String   @id @default(uuid())
  role         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  loginPath    String   @map("login_path")
  createdBy    String   @default("colossus") @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("colossus_accounts")
}

// ─── SnapGram domain ──────────────────────────────────────────────────────────

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Object-storage key, e.g. "posts/<uuid>.jpg". Used to delete the S3 object.
  imageKey String
  /// Public proxy path, e.g. "/api/media/posts/<uuid>.jpg".
  imageUrl String
  /// Max 2200 chars, enforced in the DTO.
  caption  String?

  /// Denormalised counters — only ever mutated inside the same $transaction as the
  /// Like/Comment write (PostsService/CommentsService), never anywhere else.
  likeCount    Int @default(0)
  commentCount Int @default(0)

  /// Moderator soft-removal. Every read path filters `removedAt: null`.
  /// Author deletion is a hard delete and cascades to likes/comments/reports.
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  likes    Like[]
  reports  Report[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([removedAt])
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// 1–500 chars (trimmed), enforced in the DTO.
  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

/// Composite primary key makes the like toggle idempotent by construction —
/// no surrogate id, so a double-like can never create two rows.
model Like {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// Composite primary key makes follow/unfollow idempotent by construction.
/// Self-follow is rejected in the service layer (400), not by the schema.
model Follow {
  followerId String
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

model Report {
  id         String @id @default(cuid())
  postId     String
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  /// 1–500 chars, enforced in the DTO.
  reason String
  status ReportStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One report per (post, reporter) — makes duplicate reporting idempotent.
  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@index([postId])
}

/// Lowercase values match the frontend wire type `ReportStatus = 'open' | 'closed'`.
enum ReportStatus {
  open
  closed
}

/// Runtime override layer for service credentials. resolveConfig() reads the env
/// var first and falls back to this table.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
